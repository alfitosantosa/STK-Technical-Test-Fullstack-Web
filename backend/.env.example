# Contoh konfigurasi backend.
# Copy file ini menjadi .env lalu sesuaikan nilainya.

# Koneksi PostgreSQL.
DATABASE_URL='postgresql://user:password@host:5432/nama_database?sslmode=require'

# Port HTTP server. Harus sama dengan NEXT_PUBLIC_API_URL di frontend/.env.local.
PORT=4000

# Origin yang boleh memanggil API dari browser (opsional, dipisah koma).
# Kosong berarti semua origin diizinkan, berguna untuk dev.
# CORS_ORIGINS=https://stk.santosatechid.cloud
