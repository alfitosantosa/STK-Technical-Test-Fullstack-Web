# Contoh konfigurasi untuk Docker Compose.
# Copy berkas ini menjadi .env kalau nilainya mau diubah.
# Kalau tidak ada .env, semua nilai di bawah ini yang dipakai.

# Database di dalam container production.
POSTGRES_USER=menu
# Ganti di server: database ini hanya terbuka di jaringan internal Docker.
POSTGRES_PASSWORD=menu
POSTGRES_DB=menu

# Koneksi database untuk backend.
# Di docker-compose.yml nilainya dirakit otomatis dari POSTGRES_* di atas,
# jadi baris ini hanya perlu diisi kalau memakai database lain (misalnya
# layanan database terkelola seperti Neon).
# DATABASE_URL=postgresql://user:password@host:5432/db?sslmode=require

# Origin yang boleh memanggil API langsung dari browser (dipisah koma).
# Di produksi frontend dan API satu origin lewat reverse proxy, jadi CORS tidak
# dipakai dan baris ini boleh dikosongkan. Isi hanya kalau frontend memanggil
# API dari origin berbeda, contoh: https://stk.santosatechid.cloud
# CORS_ORIGINS=

# Mode development: alamat backend dari sudut pandang browser.
# Isi kalau backend dibuka dari komputer lain, contoh:
#   NEXT_PUBLIC_API_URL=http://72.61.140.54:4000
# Mode production: biarkan kosong, frontend memanggil API di origin yang sama
# ("/api/...") dan reverse proxy yang meneruskan ke backend.
# NEXT_PUBLIC_API_URL=http://localhost:4000

# Mode development saja: host (tanpa http:// dan tanpa port) yang dipakai untuk
# membuka frontend, kalau bukan localhost. Dipakai Next agar permintaan ke
# sumber daya dev (HMR) dari host itu tidak diblokir.
# ALLOWED_DEV_ORIGINS=stk.santosatechid.cloud

# Port di host. Ubah kalau sudah dipakai proses lain.
# Di mode production port cuma dibuka di 127.0.0.1, untuk reverse proxy di host.
# DATABASE_PORT=5432
# BACKEND_PORT=4000
# FRONTEND_PORT=4001
