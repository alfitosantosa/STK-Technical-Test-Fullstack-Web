# Konfigurasi frontend.
# Copy file ini menjadi .env.local lalu sesuaikan kalau perlu.

# Alamat backend dari sudut pandang browser.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Host (tanpa http:// dan tanpa port) yang dipakai untuk membuka dev server,
# kalau bukan localhost. Dipisah koma kalau lebih dari satu.
ALLOWED_DEV_ORIGINS=stk.santosatechid.cloud
